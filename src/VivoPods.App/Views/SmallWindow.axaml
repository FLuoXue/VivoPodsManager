<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:VivoPods.App.Views" x:Class="VivoPods.App.Views.SmallWindow"
        Title="Vivo Pods · 快捷控制" Width="340" SizeToContent="Height" MaxHeight="600" CanResize="False"
        ShowInTaskbar="False" Topmost="True" SystemDecorations="None" WindowStartupLocation="Manual"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <Border Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="13">
      <Grid ColumnDefinitions="*,Auto,Auto" DoubleTapped="OpenMainFromHeader">
        <StackPanel Spacing="4"><TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ConnectionLabel}" Classes="muted" FontSize="10"/></StackPanel>
        <Button Grid.Column="1" Classes="quiet icon" ToolTip.Tip="打开主窗口" AutomationProperties.Name="打开主窗口" Click="OpenMain"><Path Data="{StaticResource OpenWindowIconGeometry}"/></Button>
        <Button Grid.Column="2" Classes="quiet icon" ToolTip.Tip="收起小窗" AutomationProperties.Name="收起小窗" Click="HideWindow"><Path Data="{StaticResource CloseIconGeometry}"/></Button>
      </Grid>
      <Border IsVisible="{Binding IsDemo}" Background="{DynamicResource TintBrush}" CornerRadius="8" Padding="10,6"><TextBlock Text="演示设备 · 模拟数据" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></Border>
      <Border Classes="card" Padding="12">
          <views:BatteryOverview ArtHeight="62" BatteryFontSize="20"/>
      </Border>
      <Border Classes="card" IsVisible="{Binding ShowNoise}" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding NoiseLabel}" Classes="muted" FontSize="11"/>
          <views:NoiseControls x:Name="QuickNoise" ModeHeight="54"/>
        </StackPanel>
      </Border>
      <StackPanel Spacing="9" IsVisible="{Binding ShowConnectionHelp}">
        <TextBlock Text="{Binding ConnectionHint}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
        <Button Content="{Binding ConnectionAction}" Classes="primary" Click="Reconnect" IsEnabled="{Binding CanScan}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding ConnectionDetail}" Classes="muted" FontSize="10" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="更多设置 →" Classes="quiet" Padding="4" FontSize="11" Click="OpenMain"/>
      </Grid>
    </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
