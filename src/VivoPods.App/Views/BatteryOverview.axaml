<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:VivoPods.App.Views" x:Class="VivoPods.App.Views.BatteryOverview" x:Name="BatteryRoot">
  <Grid ColumnDefinitions="*,*,*">
    <StackPanel Spacing="5" Margin="6,0" Opacity="{Binding LeftOpacity}">
      <Panel Height="{Binding ArtHeight, ElementName=BatteryRoot}" Margin="0,0,0,8">
        <views:EarbudsArt Part="Left" MaxWidth="105" IsVisible="{Binding ShowGenericDeviceArt}"/>
        <Image Source="{Binding LeftImage}" MaxWidth="105" Stretch="Uniform" IsVisible="{Binding ShowOfficialDeviceArt}"/>
      </Panel>
      <TextBlock Text="左耳" Classes="muted" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding LeftBattery}" FontSize="{Binding BatteryFontSize, ElementName=BatteryRoot}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <ProgressBar Classes="battery" Value="{Binding LeftLevel}" Maximum="100" MinWidth="0" MaxWidth="104" HorizontalAlignment="Stretch"/>
      <TextBlock Text="{Binding LeftStatus}" Classes="muted" FontSize="10" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="5" Margin="6,0" Opacity="{Binding CaseOpacity}">
      <Panel Height="{Binding ArtHeight, ElementName=BatteryRoot}" Margin="0,0,0,8">
        <views:EarbudsArt Part="Case" MaxWidth="180" IsVisible="{Binding ShowGenericDeviceArt}"/>
        <Image Source="{Binding CaseImage}" MaxWidth="180" Stretch="Uniform" IsVisible="{Binding ShowOfficialDeviceArt}"/>
      </Panel>
      <TextBlock Text="充电盒" Classes="muted" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding CaseBattery}" FontSize="{Binding BatteryFontSize, ElementName=BatteryRoot}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <ProgressBar Classes="battery" Value="{Binding CaseLevel}" Maximum="100" MinWidth="0" MaxWidth="104" HorizontalAlignment="Stretch"/>
      <TextBlock Text="{Binding CaseStatus}" Classes="muted" FontSize="10" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Spacing="5" Margin="6,0" Opacity="{Binding RightOpacity}">
      <Panel Height="{Binding ArtHeight, ElementName=BatteryRoot}" Margin="0,0,0,8">
        <views:EarbudsArt Part="Right" MaxWidth="105" IsVisible="{Binding ShowGenericDeviceArt}"/>
        <Image Source="{Binding RightImage}" MaxWidth="105" Stretch="Uniform" IsVisible="{Binding ShowOfficialDeviceArt}"/>
      </Panel>
      <TextBlock Text="右耳" Classes="muted" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding RightBattery}" FontSize="{Binding BatteryFontSize, ElementName=BatteryRoot}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <ProgressBar Classes="battery" Value="{Binding RightLevel}" Maximum="100" MinWidth="0" MaxWidth="104" HorizontalAlignment="Stretch"/>
      <TextBlock Text="{Binding RightStatus}" Classes="muted" FontSize="10" HorizontalAlignment="Center"/>
    </StackPanel>
  </Grid>
</UserControl>
